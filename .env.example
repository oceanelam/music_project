# ============================================================================
# ROOT ENVIRONMENT VARIABLES (used by docker compose and backend)
# ============================================================================
# Copy this file to .env before starting:
# cp .env.example .env

# Server Listening Port
PORT=5000

# Your secret Last.fm API Key (Kept safe on backend, never exposed to browser)
LASTFM_API_KEY=YOUR_LASTFM_API_KEY

# Your personal Last.fm username
LASTFM_USERNAME=YOUR_LASTFM_USERNAME

# Cache expiration TTL in seconds
CACHE_TTL_SECONDS=60
