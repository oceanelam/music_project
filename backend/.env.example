# ============================================================================
# SERVER ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your actual Last.fm API Key:
# cp .env.example .env
#
# IMPORTANT:
# - Never commit your real .env to git (it is included in .gitignore)
# - The browser frontend NEVER accesses this file or variable
# ============================================================================

# Server Listening Port
PORT=5000

# Last.fm API Key (Obtain from https://www.last.fm/api/account/create)
LASTFM_API_KEY=your_lastfm_api_key_here

# Default Last.fm username to display if none specified
LASTFM_DEFAULT_USER=rj

# In-Memory Cache Time-To-Live in seconds (Default: 60)
CACHE_TTL_SECONDS=60
